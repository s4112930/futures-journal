{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "futures-journal-staging",
  "main": "staging.js",
  "compatibility_date": "2026-08-29",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/health",
      "/ig/*",
      "/api/*"
    ]
  }
}
